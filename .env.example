# Local defaults that work with `docker compose up`. `pnpm dev` copies this to .env.
# Runtime
NODE_ENV=development
DRIPSIGN_PUBLIC_ORIGIN=http://127.0.0.1:3000
DRIPSIGN_TRUSTED_PROXY_HOPS=0
# Database
DRIPSIGN_DATABASE_URL=postgres://dripsign:dripsign@127.0.0.1:5433/dripsign
# Auth: replace-me is swapped for a random secret by `pnpm dev`; at least 32 bytes.
DRIPSIGN_AUTH_SECRET=replace-me
# Dev sign-in shortcut: loopback origin and non-production only.
DRIPSIGN_DEV_LOGIN=1
# Document storage: file locally, s3 in production.
DRIPSIGN_STORAGE=file
DRIPSIGN_STORAGE_DIR=.data/storage
DRIPSIGN_S3_BUCKET=
AWS_REGION=
DRIPSIGN_S3_KMS_KEY_ID=
# Email: Mailpit locally, ses in production.
DRIPSIGN_EMAIL_TRANSPORT=smtp
DRIPSIGN_SMTP_URL=smtp://127.0.0.1:1025
DRIPSIGN_EMAIL_FROM="DripSign <no-reply@dripsign.test>"
# AI suggestions: off while the API key is blank.
DRIPSIGN_ANTHROPIC_API_KEY=
DRIPSIGN_AI_MODEL=claude-sonnet-5-5
DRIPSIGN_AI_DAILY_LIMIT_USD=10
# Jobs worker
DRIPSIGN_JOBS_CONCURRENCY=4
# Host integration (JSON) and event signing seed: both blank means off.
DRIPSIGN_HOST=
DRIPSIGN_HOST_EVENT_SEED=
