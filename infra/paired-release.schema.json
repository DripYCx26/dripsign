{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dripsign.com/schemas/paired-release-v1.json",
  "title": "Private paired DripSign and host release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "releaseId",
    "dripsign",
    "v2",
    "rollback"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "dripsign": {
      "$ref": "#/$defs/dripsign"
    },
    "v2": {
      "$ref": "#/$defs/v2"
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dripsign",
        "v2"
      ],
      "properties": {
        "dripsign": {
          "$ref": "#/$defs/dripsign"
        },
        "v2": {
          "$ref": "#/$defs/v2"
        }
      }
    }
  },
  "$defs": {
    "dripsign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "commit",
        "ui",
        "apiVersion",
        "schema"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "integrity"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
            },
            "integrity": {
              "type": "string",
              "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
            }
          }
        },
        "apiVersion": {
          "type": "integer",
          "minimum": 1
        },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum"
          ],
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 1
            },
            "maximum": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "commit",
        "acceptedApiVersions"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "acceptedApiVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
